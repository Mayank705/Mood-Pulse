# --- Database ---
# Local dev (SQLite, zero infra):
DATABASE_URL="file:./dev.db"
# Production (Azure SQL) — after switching prisma/schema.prisma datasource
# provider to "sqlserver":
# DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<password>;encrypt=true"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_TIMEZONE=Asia/Kolkata

# --- Auth ---
# AUTH_MODE=dev uses the built-in dev auth provider (issues JWTs shaped like
# validated Entra ID tokens) so the app runs without an Azure tenant.
# AUTH_MODE=entra validates real Microsoft Entra ID access tokens via JWKS.
AUTH_MODE=dev
JWT_SECRET=replace-with-a-long-random-secret-in-every-environment
JWT_EXPIRES_IN=8h

# --- Entra ID (used when AUTH_MODE=entra) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=

# --- Seed / bootstrap (dev only, never used in production) ---
SEED_SUPER_ADMIN_EMAIL=admin@dailypulse.dev
